{
  "name": "zhijian-resume-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "start": "node dist/cli.cjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx tests/smoke.ts",
    "test:ui": "tsx tests/ui-smoke.ts",
    "package": "node scripts/package.mjs",
    "release:windows": "powershell.exe -NoProfile -File scripts/release.ps1",
    "release:macos": "npm run build && node scripts/package.mjs macos",
    "test:install": "tsx tests/install-smoke.ts",
    "notices": "node scripts/notices.mjs",
    "package:doubao": "node scripts/package-doubao.mjs",
    "release:doubao": "npm run build && npm run package:doubao",
    "test:doubao-package": "tsx tests/doubao-package-smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/html": "^0.36.1",
    "@lexical/list": "^0.36.1",
    "@lexical/react": "^0.36.1",
    "@lexical/utils": "^0.36.1",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/mcp-extensions": "^0.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^10.1.3",
    "lexical": "^0.36.1",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.5.438",
    "puppeteer-core": "^25.18.1",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-easy-crop": "^5.5.6",
    "sanitize-html": "^2.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^20.11.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "智简简历：在 AI 对话中编辑简历、切换模板、调整行距并导出分页 PDF，本地运行。",
  "engines": {
    "node": ">=22.13.0"
  },
  "homepage": "https://github.com/meyhuan/zhijian-resume-plugin",
  "repository": "https://github.com/meyhuan/zhijian-resume-plugin",
  "overrides": {
    "@openai/mcp-extensions": {
      "zod": "$zod"
    }
  }
}
